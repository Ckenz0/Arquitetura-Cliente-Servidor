# Copie para .env na raiz. Este arquivo é lido apenas pelo servidor.
APP_ENV=development
# Em desenvolvimento, vazio gera uma chave por inicialização.
# Em produção, gere uma chave aleatória estável com pelo menos 32 caracteres.
SECRET_KEY=
# Origens exatas do CLIENTE, sem barra final. Separe por vírgula.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
PORT=5000
